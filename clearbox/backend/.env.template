# Database Configuration
# PostgreSQL connection string for production
DATABASE_URL=postgresql://username:password@your-rds-endpoint:5432/clearbox

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_production_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption
# Generate a secure key using: openssl rand -hex 32
ENCRYPTION_KEY=your_production_encryption_key_here

# MQTT Configuration
MQTT_BROKER=your_production_mqtt_broker
MQTT_PORT=8883
# For secure MQTT connections
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_USE_TLS=true

# Server Configuration
PORT=8000
# Environment: development, testing, production
ENVIRONMENT=production
# CORS settings for production
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com 