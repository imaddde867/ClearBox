# Database Configuration
DATABASE_URL=sqlite:///./clearbox.db

# Security Settings
SECRET_KEY=generate_a_secure_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
# MQTT_USERNAME=your_mqtt_username  # Uncomment and set if needed
# MQTT_PASSWORD=your_mqtt_password  # Uncomment and set if needed

# Encryption Configuration
# Required: the app refuses to start if this is empty. Changing it makes
# messages encrypted with the old value unreadable.
ENCRYPTION_KEY=
# Optional: previous key, decryption only. Set temporarily during key rotation,
# then run migrations/reencrypt_messages.py and remove it.
# LEGACY_ENCRYPTION_KEY=

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Optional PostgreSQL Configuration (uncomment to use)
# DATABASE_URL=postgresql://username:password@localhost/clearbox

