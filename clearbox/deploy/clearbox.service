[Unit]
Description=ClearBox Secure Messaging API
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/clearbox
ExecStart=/home/ec2-user/.local/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8000
Restart=always
RestartSec=5
Environment=ENVIRONMENT=production
Environment=DATABASE_URL=postgresql://username:password@your-database-endpoint:5432/clearbox
Environment=SECRET_KEY=your_secret_key
Environment=ENCRYPTION_KEY=your_encryption_key
Environment=MQTT_BROKER=localhost
Environment=MQTT_PORT=8883
Environment=MQTT_USERNAME=mqtt_username
Environment=MQTT_PASSWORD=mqtt_password
Environment=MQTT_USE_TLS=true
Environment=PORT=8000
Environment=CORS_ORIGINS=https://your-domain.com

[Install]
WantedBy=multi-user.target 